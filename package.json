{
  "name": "resolume-streamdeck",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.calebweixun.resolume-monitor\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "streamdeck validate com.calebweixun.resolume-monitor.sdPlugin",
    "pack": "streamdeck pack com.calebweixun.resolume-monitor.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.3.0",
    "rollup": "^4.62.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
